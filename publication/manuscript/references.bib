@article{Raub1965,
   abstract = {Superconductivity has been discovered in Pd compounds with Se and Te, in IrTe3 and in PtTe. The superconducting transition temperature of a Pd-Se alloy containing 85 to 87 at.% Pd is 0.66°K which is unusually high for its valence-electron concentration. A homogeneity range exists for the hexagonal B81-type compound PdTe and for the trigonal C6-type compound PdTe2. The results of the low temperature heat capacity measurements of PdTe and PdTe1.04 show that the large change in the transition temperature with composition is accompanied by a large change in the linear heat capacity coefficient, γ. © 1965.},
